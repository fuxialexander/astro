# Astro Environment Configuration
# ================================
#
# Three operating modes:
#   local — PGlite, no auth, no config needed (npm run dev:local)
#   dev   — Local Supabase + Cloudflare tunnel (npm run env:dev)
#   prod  — Remote Supabase + Fly.io + Cloudflare Pages (npm run env:prod)
#
# Setup:
#   1. cp .env.example .env
#   2. Fill in the SHARED SECRETS section below
#   3. npm run env:init            # generates .env.local.dev + .env.prod
#   4. Edit .env.prod        # fill in remote Supabase credentials
#   5. npm run env:dev             # switch to dev mode
#      npm run env:prod            # switch to prod mode
#
# File layout:
#   .env              ← This file. Shared secrets. Git-ignored.
#   .env.local        ← Symlink → active profile (managed by switch-env.sh)
#   .env.local.dev    ← Dev profile (auto-generated from CLOUDFLARED_DOMAIN)
#   .env.prod   ← Prod profile (you fill in remote Supabase creds)
#   .env.example      ← This template. Committed to git.
#
# NEVER commit .env or .env.local* to git.


# ═══════════════════════════════════════════
#  SHARED SECRETS  (used across all modes)
# ═══════════════════════════════════════════

# --- JWT Secrets ---
# Used to sign auth tokens for agent runners connecting to the relay.
# All three MUST be different. Generate each with: openssl rand -hex 32
# For local dev, any string works. In production, use strong random values.
RELAY_JWT_SECRET=dev-relay-secret-not-for-production-use-only
DEVICE_AUTH_JWT_SECRET=dev-device-auth-secret-not-for-production-use
DEVICE_AUTH_REFRESH_SECRET=dev-device-refresh-secret-not-for-prod


# ═══════════════════════════════════════════
#  DEPLOYMENT TARGETS
# ═══════════════════════════════════════════
# Used by deploy scripts. Not read by the server at runtime.

# Fly.io app name for backend deployment
# Must match the `app` field in fly.toml. Find at: https://fly.io/apps
FLY_APP=astro-backend-deploy

# Cloudflare Pages project name for frontend deployment
# Find at: https://dash.cloudflare.com → Workers & Pages → your project
CLOUDFLARE_PAGES_PROJECT=astro-app

# Cloudflare tunnel domain (required for dev mode)
# This is the domain your Cloudflare tunnel routes to (e.g. example.com)
# Tunnel creates subdomains: astro.example.com, astro-api.example.com, etc.
# Find at: https://one.dash.cloudflare.com → Networks → Tunnels
# CLOUDFLARED_DOMAIN=example.com


# ═══════════════════════════════════════════
#  PROD PROFILE  (.env.prod)
# ═══════════════════════════════════════════
# These go in .env.prod (generated by `npm run env:init`).
# Listed here for reference — do NOT uncomment them in .env.
#
# --- Remote Supabase ---
# Find at: https://supabase.com → your project → Settings → API
#
# SUPABASE_URL=https://XXXX.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
#
# --- Frontend build vars (baked into the JS bundle) ---
# These MUST match your remote Supabase project.
#
# VITE_SUPABASE_URL=https://XXXX.supabase.co          # Same as SUPABASE_URL
# VITE_SUPABASE_ANON_KEY=eyJ...                       # Same as SUPABASE_ANON_KEY
# VITE_API_BASE_URL=https://<your-fly-app>.fly.dev          # Your Fly.io app URL
#
# --- Database (server-side only) ---
# Postgres connection string for direct DB access.
# Find at: Supabase Dashboard → Settings → Database → Connection string
# Use "Transaction" / pooler mode (port 6543), NOT direct (port 5432).
#
# DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres


# ═══════════════════════════════════════════
#  OPTIONAL
# ═══════════════════════════════════════════

# --- Claude SDK Authentication ---
# Only needed if the server itself calls Claude (plan generation, chat).
# Agent execution uses the END USER's credentials via their agent runner.
#
# Auth methods (priority order):
#   1. Claude Code OAuth     — automatic if user is logged into Claude Code
#   2. AWS Bedrock           — set CLAUDE_CODE_USE_BEDROCK=1 + AWS credentials
#   3. Anthropic API key     — fallback, not recommended for production
#
# CLAUDE_CODE_USE_BEDROCK=1
# ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase OAuth Providers ---
# Enable social login (GitHub, Google) via Supabase Auth.
# Create OAuth apps and set credentials here + in Supabase dashboard/CLI.
# Callback URL: https://XXXX.supabase.co/auth/v1/callback
#
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- User Notifications (Telegram) ---
# Used by the Telegram channel adapter to send task/approval notifications to users.
# Users link their Telegram from Astro Settings; this bot sends them project updates.
#
# TELEGRAM_BOT_TOKEN=7123456789:AAH...

# --- Server Monitoring (Telegram alerts) ---
# Separate bot for server health monitoring: status reports, health checks, recovery.
# Create a SECOND bot via @BotFather to keep monitoring out of user notifications.
# Falls back to TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID if not set.
# See docs/guides/monitoring.md for setup instructions.
#
# MONITOR_TELEGRAM_BOT_TOKEN=7987654321:BBX...
# MONITOR_TELEGRAM_CHAT_ID=-100XXXXXXXXXX

# --- Redis ---
# Only needed for horizontal scaling (multiple backend instances).
# Single instance works without it.
# REDIS_URL=redis://...

# --- Relay port ---
# Default: 3002. Only change if you have a port conflict.
# RELAY_PORT=3002
