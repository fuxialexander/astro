# Astro Environment Configuration
# ================================
#
# This file configures BOTH local development AND production deployment.
#
# Setup:
#   1. cp .env.example .env
#   2. Fill in your values
#   3. For local dev:  npm run dev  (reads .env automatically)
#   4. For production: fly secrets import --app astro-backend-platform < .env
#                      then delete secrets from .env or delete .env entirely
#
# Fly.io encrypts secrets at rest. The .env file is just a local staging area.
# NEVER commit .env to git.


# ═══════════════════════════════════════════
#  DEPLOYMENT TARGET
# ═══════════════════════════════════════════
# These are read by deploy scripts, not by the server at runtime.

FLY_APP=astro-backend-platform
CLOUDFLARE_PAGES_PROJECT=astro-app


# ═══════════════════════════════════════════
#  BACKEND SECRETS  (pushed to Fly.io)
# ═══════════════════════════════════════════

# --- JWT Secrets ---
# Used to sign auth tokens for agent runners connecting to the relay.
# All three MUST be different. Generate each with: openssl rand -hex 32
# For local dev, any string works. In production, Fly.io enforces 256-bit minimum.
RELAY_JWT_SECRET=dev-relay-secret-not-for-production-use-only
DEVICE_AUTH_JWT_SECRET=dev-device-auth-secret-not-for-production-use
DEVICE_AUTH_REFRESH_SECRET=dev-device-refresh-secret-not-for-prod

# --- Database ---
# Postgres connection string.
# Local dev:  leave empty or point to local Supabase (port 54322)
# Production: Supabase Dashboard → Settings → Database → Connection string
#             Use "Transaction" / pooler mode (port 6543), NOT direct (port 5432).
# DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Supabase ---
# HTTP API for auth, realtime, and storage.
# Local dev:  leave empty to use IndexedDB mode (no auth, single-user)
# Production: Supabase Dashboard → Settings → API
# SUPABASE_URL=https://XXXX.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- WebAuthn (passkey login) ---
# Domain and origin for passkey registration/login.
# Local dev:  defaults to localhost (no config needed)
# Production: set to your Fly.io domain or custom domain.
# WEBAUTHN_RP_ID=astro-backend-platform.fly.dev
# WEBAUTHN_ORIGIN=https://astro-backend-platform.fly.dev

# --- CORS ---
# Which frontend URL(s) are allowed to call the backend cross-origin.
# Local dev:  localhost:5173 is always allowed (no config needed)
# Production: set to your frontend URL (Cloudflare Pages or custom domain).
# All three should typically be the same URL.
# ASTRO_BASE_URL=https://astro.fuxialexander.work
# CORS_ORIGIN=https://astro.fuxialexander.work
# FRONTEND_URL=https://astro.fuxialexander.work
# ASTRO_NOREPLY_EMAIL=noreply@astro.fuxialexander.work


# ═══════════════════════════════════════════
#  OPTIONAL
# ═══════════════════════════════════════════

# --- Claude SDK Authentication ---
# The Anthropic Agent SDK supports multiple auth methods. In production,
# agent execution always uses the END USER's credentials (via their
# agent runner), not a server-side key. These are only relevant if the
# server itself needs to call Claude (e.g., the procedure classifier
# or direct chat fallback). All are optional — the server starts and
# runs fine without any of them.
#
# Auth methods (in priority order):
#   1. Claude Code OAuth     — automatic if user is logged into Claude Code
#   2. AWS Bedrock           — set CLAUDE_CODE_USE_BEDROCK=1 + AWS credentials
#   3. Anthropic API key     — fallback, not recommended for production
#
# CLAUDE_CODE_USE_BEDROCK=1
# ANTHROPIC_API_KEY=sk-ant-...  (fallback only, not needed in production)

# --- Redis ---
# Only needed for horizontal scaling (multiple backend instances).
# Single instance works without it.
# REDIS_URL=redis://...

# --- Relay port ---
# Default: 3002. Only change if you have a port conflict.
# RELAY_PORT=3002


# ═══════════════════════════════════════════
#  FRONTEND BUILD CONFIG  (used locally, not pushed to Fly.io)
# ═══════════════════════════════════════════
# The frontend needs to know where the backend is.
# Local dev:  leave empty (Vite proxies /api to localhost:3001)
# Production: set to your Fly.io backend URL.
# VITE_API_BASE_URL=https://astro-backend-platform.fly.dev
