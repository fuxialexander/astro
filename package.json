{
  "name": "astro",
  "private": true,
  "version": "0.0.11",
  "type": "module",
  "main": ".vite/build/index.js",
  "scripts": {
    "dev": "PORT=${PORT:-4001} RELAY_PORT=${RELAY_PORT:-4002} concurrently -n fe,be,cli,agent -c blue,green,cyan,yellow \"vite\" \"tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts\" \"npm run --prefix packages/cli watch\" \"sleep 4 && npm run dev:agent\"",
    "dev:local": "bash scripts/switch-env.sh local && npm run dev",
    "dev:dev": "bash scripts/switch-env.sh dev && bash ./scripts/dev-with-tunnel.sh",
    "dev:agent": "ASTRO_SERVER_URL=http://localhost:${PORT:-3001} tsx packages/agent-runner/src/cli.ts start --foreground --relay ws://localhost:${RELAY_PORT:-3002} --max-tasks 4 --log-level info",
    "dev:tunnel": "bash ./scripts/dev-with-tunnel.sh",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "gen:ipc": "tsx scripts/gen-ipc-bridge.ts",
    "build:frontend": "tsc -b && vite build",
    "build:server": "tsc -b",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "build:all": "tsc -b && vite build && npm run --prefix packages/agent-runner build",
    "build:agent-runner": "npm run --prefix packages/agent-runner build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "bash ./scripts/deploy.sh",
    "deploy:backend": "bash ./scripts/deploy.sh backend",
    "deploy:frontend": "bash ./scripts/deploy.sh frontend",
    "verify": "bash scripts/verify-setup.sh",
    "env:switch": "bash scripts/switch-env.sh",
    "env:local": "bash scripts/switch-env.sh local",
    "env:dev": "bash scripts/switch-env.sh dev",
    "env:prod": "bash scripts/switch-env.sh prod",
    "env:init": "bash scripts/switch-env.sh init",
    "astro-cli": "tsx packages/cli/src/index.ts",
    "astro-tui": "node --import tsx/esm packages/tui/src/index.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:push": "bash scripts/db-push.sh",
    "db:push:dry-run": "bash scripts/db-push.sh --dry-run",
    "db:status": "bash scripts/db-push.sh --status",
    "db:reset": "bash scripts/reset-database.sh --all",
    "db:reset:supabase": "bash scripts/reset-database.sh --supabase",
    "clear-data": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/clear-user-data.ts",
    "clear-data:force": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/clear-user-data.ts --force",
    "cleanup-duplicates": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/cleanup-duplicate-machines.ts",
    "flags": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-feature-flags.ts",
    "flags:status": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-feature-flags.ts --status",
    "flags:dry-run": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-feature-flags.ts --dry-run",
    "postinstall": "([ -d packages/agent-runner ] && cd packages/agent-runner && npm install --ignore-scripts || true) && (electron-rebuild -f -w node-pty || echo '[postinstall] electron-rebuild skipped or failed — terminal will use NOT_REBUILT fallback until you run: npx electron-rebuild -f -w node-pty')",
    "electron:build:main": "tsc -p electron/tsconfig.electron.json && tsc -p electron/tsconfig.preload.json",
    "electron:build:server": "tsx scripts/build-server.ts",
    "build:binaries": "tsx scripts/build-binaries.ts",
    "build:binaries:local": "tsx scripts/build-binaries.ts --local",
    "build:calendar-helper": "bash scripts/build-calendar-helper.sh",
    "electron:dev": "concurrently -n vite,electron -c blue,cyan \"vite\" \"wait-on http://localhost:5173 && npm run electron:build:server && npm run electron:build:main && electron electron/dist/main/index.js\"",
    "electron:package": "bash -c 'set -a; [ -f .env.prod ] && . .env.prod; set +a; npm run build:binaries && electron-forge package'",
    "electron:make": "bash -c 'set -a; [ -f .env.prod ] && . .env.prod; set +a; npm run build:binaries && electron-forge make'",
    "electron:publish": "bash -c 'set -a; [ -f .env.prod ] && . .env.prod; set +a; npm run build:calendar-helper && GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} electron-forge publish'",
    "desktop": "bash scripts/switch-env.sh local && concurrently -k -n desktop,agent -c blue,yellow \"npm run electron:dev\" \"sleep 6 && npm run dev:agent\"",
    "desktop:dev": "npm run desktop",
    "desktop:package": "npm run electron:package",
    "desktop:make": "npm run electron:make",
    "prepare": "husky"
  },
  "packageManager": "pnpm@9.15.4",
  "config": {
    "forge": "./electron/forge.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.50",
    "@anthropic-ai/sdk": "^0.78.0",
    "@dagrejs/dagre": "^2.0.4",
    "@dnd-kit/core": "^6.3.1",
