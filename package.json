{
  "name": "nexus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n fe,be -c blue,green \"vite\" \"tsx watch --env-file-if-exists=.env server/index.ts\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=nexus-app",
    "verify": "bash scripts/verify-setup.sh",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky"
  },
