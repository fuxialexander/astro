{
  "name": "nexus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n fe,be -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=nexus-app"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.32",
    "@hono/node-server": "^1.19.9",
