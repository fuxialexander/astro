{
  "name": "nexus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n fe,be -c blue,green \"vite\" \"tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts\"",
    "dev:tunnel": "bash ./scripts/dev-with-tunnel.sh",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "dev:indexeddb": "USE_INDEXEDDB_ONLY=true VITE_USE_INDEXEDDB_ONLY=true npm run dev",
    "dev:supabase": "bash ./scripts/setup-supabase-local.sh && npm run dev",
    "tunnel": "bash ./scripts/start-tunnel-with-supabase.sh",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:frontend": "npm run build && wrangler pages deploy dist --project-name=nexus-app",
    "deploy:backend": "bash ./scripts/deploy-fly.sh",
    "deploy": "npm run deploy:backend && npm run deploy:frontend",
    "deploy:prod": "npm run deploy:backend && npm run deploy:frontend",
    "fly:logs": "fly logs",
    "fly:status": "fly status",
    "fly:ssh": "fly ssh console",
    "verify": "bash scripts/verify-setup.sh",
    "verify:env": "bash scripts/verify-environment-setup.sh",
    "env:fix-permissions": "bash scripts/fix-env-permissions.sh",
    "env:setup": "cp .env.example .env && echo '\n✅ Created .env file. Edit it and replace placeholder values.\n'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:approval": "tsx scripts/test-approval-automated.ts",
    "test:approval:integration": "tsx scripts/test-approval-integration.ts",
    "test:approval:interactive": "tsx scripts/test-approval-system.ts",
    "test:approval:quick": "bash scripts/test-approval-quick.sh",
    "demo:approval": "tsx scripts/demo-approval-flow.ts",
    "db:reset": "bash scripts/reset-database.sh --all",
    "db:reset:supabase": "bash scripts/reset-database.sh --supabase",
    "db:reset:indexeddb": "bash scripts/reset-database.sh --indexeddb",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.32",
    "@anthropic-ai/sdk": "^0.74.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-virtual": "^3.13.18",
    "@xyflow/react": "^12.8.2",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.1",
    "fuse.js": "^7.1.0",
    "hono": "^4.11.7",
    "hono-rate-limiter": "^0.5.3",
    "idb-keyval": "^6.2.1",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.511.0",
    "postgres": "^3.4.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router": "^7.6.1",
    "tailwind-merge": "^3.3.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4",
    "wrangler": "^4.63.0"
  }
}
