{
  "name": "astro",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n fe,be,agent -c blue,green,yellow \"vite\" \"tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts\" \"sleep 2 && npm run dev:agent\"",
    "dev:local": "bash scripts/switch-env.sh local && npm run dev",
    "dev:dev": "bash scripts/switch-env.sh dev && bash ./scripts/dev-with-tunnel.sh",
    "dev:agent": "tsx packages/agent-runner/src/cli.ts start --foreground --relay ws://localhost:3002 --max-tasks 4 --log-level info",
    "dev:tunnel": "bash ./scripts/dev-with-tunnel.sh",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "build:frontend": "tsc -b && vite build",
    "build:server": "tsc -b",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "build:all": "tsc -b && vite build && npm run --prefix packages/agent-runner build",
    "build:agent-runner": "npm run --prefix packages/agent-runner build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "bash ./scripts/deploy.sh",
    "deploy:backend": "bash ./scripts/deploy.sh backend",
    "deploy:frontend": "bash ./scripts/deploy.sh frontend",
    "verify": "bash scripts/verify-setup.sh",
    "env:switch": "bash scripts/switch-env.sh",
    "env:local": "bash scripts/switch-env.sh local",
    "env:dev": "bash scripts/switch-env.sh dev",
    "env:prod": "bash scripts/switch-env.sh prod",
    "env:init": "bash scripts/switch-env.sh init",
    "astro-cli": "tsx packages/cli/src/index.ts",
    "astro-tui": "node --import tsx/esm packages/tui/src/index.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:approval": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-approval-automated.ts",
    "test:approval:integration": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-approval-integration.ts",
    "demo:approval": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/demo-approval-flow.ts",
    "db:reset": "bash scripts/reset-database.sh --all",
    "db:reset:supabase": "bash scripts/reset-database.sh --supabase",
    "clear-data": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/clear-user-data.ts",
    "clear-data:force": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/clear-user-data.ts --force",
    "cleanup-duplicates": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/cleanup-duplicate-machines.ts",
    "flags": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-feature-flags.ts",
    "flags:status": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-feature-flags.ts --status",
    "flags:dry-run": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-feature-flags.ts --dry-run",
    "postinstall": "[ -d packages/agent-runner ] && cd packages/agent-runner && npm install --ignore-scripts || true",
    "prepare": "husky"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.50",
    "@anthropic-ai/sdk": "^0.78.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.3.15",
    "@hono/node-server": "^1.19.11",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.3",
    "@supabase/supabase-js": "^2.99.0",
    "@tanstack/react-virtual": "^3.13.21",
    "@tiptap/extension-image": "^3.20.1",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-mention": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-task-item": "^3.20.1",
    "@tiptap/extension-task-list": "^3.20.1",
    "@tiptap/extension-typography": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@tiptap/suggestion": "^3.20.1",
    "@xyflow/react": "^12.8.2",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "croner": "^10.0.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "driver.js": "^1.4.0",
    "drizzle-orm": "^0.45.1",
    "fuse.js": "^7.1.0",
    "hono": "^4.12.5",
    "hono-rate-limiter": "^0.5.3",
    "i18next": "^25.8.17",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "ink": "^6.8.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.4",
    "mermaid": "^11.13.0",
    "postgres": "^3.4.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.6",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.2",
    "react-router": "^7.13.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.0",
    "tippy.js": "^6.3.7",
    "ws": "^8.19.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@opencode-ai/sdk": "^1.2.22",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3": "^7.4.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.0.18",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4",
    "wrangler": "^4.71.0"
  }
}
