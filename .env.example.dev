# Astro — Dev Mode (local Supabase + Cloudflare tunnel)
# Activate with: npm run dev:dev
#
# Prerequisites:
#   1. Docker running (for local Supabase)
#   2. Cloudflare tunnel configured (for HTTPS — required for WebAuthn/passkeys)
#   3. CLOUDFLARED_DOMAIN set in .env
#
# Setup:
#   1. npm run env:init          # generates this file as .env.local.dev
#   2. npm run env:dev           # symlinks .env.local → .env.local.dev
#   3. npm run dev               # starts everything
#
# The env:init script auto-generates most values from CLOUDFLARED_DOMAIN in .env.
# Below are the expected variables for reference.

# ── WebAuthn ────────────────────────────────────────────────────────
# Must match your Cloudflare tunnel domain for HTTPS (required for TouchID/passkeys)
WEBAUTHN_RP_NAME=Astro
WEBAUTHN_RP_ID=astro.your-domain.com
WEBAUTHN_ORIGIN=https://astro.your-domain.com
ALLOWED_HOSTS=astro.your-domain.com,your-domain.com,localhost

# ── Local Supabase (exposed via tunnel) ─────────────────────────────
# These are your local Supabase keys (from `npx supabase status`)
SUPABASE_URL=https://astro-supabase.your-domain.com
SUPABASE_ANON_KEY=your-local-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-supabase-service-role-key
VITE_SUPABASE_URL=https://astro-supabase.your-domain.com
VITE_SUPABASE_ANON_KEY=your-local-supabase-anon-key

# ── Vite HMR over tunnel ────────────────────────────────────────────
VITE_HMR_PROTOCOL=wss
VITE_HMR_HOST=astro.your-domain.com
VITE_HMR_PORT=443

# ── API ──────────────────────────────────────────────────────────────
# No override needed — tunnel proxies everything
VITE_API_BASE_URL=

# ── GitHub OAuth callback via tunnel ─────────────────────────────────
GITHUB_REDIRECT_URI=https://astro-api.your-domain.com/api/github/callback
