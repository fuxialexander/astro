# Astro — Prod Mode (Fly.io + Cloudflare Pages + remote Supabase)
# Activate with: npm run env:prod
#
# Prerequisites:
#   1. Remote Supabase project created (https://supabase.com)
#   2. Fly.io app deployed (fly launch / fly deploy)
#   3. Cloudflare Pages project created
#
# Setup:
#   1. npm run env:init          # generates this file as .env.prod
#   2. Fill in all values below
#   3. npm run env:prod          # symlinks .env.local → .env.prod
#   4. npm run deploy            # build + deploy to Fly.io + Cloudflare Pages

# ── WebAuthn ────────────────────────────────────────────────────────
# Must match your Cloudflare Pages frontend domain
WEBAUTHN_RP_NAME=Astro
WEBAUTHN_RP_ID=your-project.pages.dev
WEBAUTHN_ORIGIN=https://your-project.pages.dev
ALLOWED_HOSTS=your-project.pages.dev,localhost

# ── CORS / Frontend URL ─────────────────────────────────────────────
CORS_ORIGIN=https://your-project.pages.dev
FRONTEND_URL=https://your-project.pages.dev
ASTRO_BASE_URL=https://your-project.pages.dev

# ── Frontend build — point API calls to Fly.io backend ──────────────
VITE_API_BASE_URL=https://your-fly-app.fly.dev

# ── Remote Supabase ─────────────────────────────────────────────────
# Find at: https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ── GitHub OAuth callback via Fly.io ─────────────────────────────────
GITHUB_REDIRECT_URI=https://your-fly-app.fly.dev/api/github/callback

# ── Supabase OAuth Providers (optional) ──────────────────────────────
# Enable social login via Supabase Auth.
# Create OAuth apps and set credentials here + in Supabase dashboard.
# Callback URL: https://your-project-ref.supabase.co/auth/v1/callback
#
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
