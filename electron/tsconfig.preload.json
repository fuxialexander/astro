{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "outDir": "./dist/preload",
    "rootDir": "./preload",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noImplicitAny": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["preload/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
